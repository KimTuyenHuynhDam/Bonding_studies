#Load Packages
library(DESeq2) #DESeq Library - Analyze Differential Gene Expression
library(DEGreport)  #Converts DESeq results for plotting
library(apeglm) #Algorithm for shrinkage
library(EnhancedVolcano)  #Plotting Volcano Plots
library('ashr') #Algorithm for shrinkage
library(readr)  #Read in delimited files
library(ggplot2)  #Plotting Library
# Reading in your data
aliveCounts <- read_delim(file.choose(), "\t", trim_ws=TRUE)
# Reading in your data
aliveCounts <- read_delim(file.choose(), "\t", trim_ws=TRUE)
deceasedCounts <- read_delim(file.choose(), "\t", trim_ws=TRUE)
Genes <- read_delim(file.choose(), "\t", trim_ws=TRUE)
# Cleaning up the data
#Find NA values
is.na(aliveCounts)
names(aliveCounts)
aliveNames <- names(aliveCounts)
names(aliveCounts) <- c(1:39)
aliveCounts
is.na(aliveCounts)
colSums(is.na(aliveCounts))
which(colSums(is.na(aliveCounts))>0)
aliveCounts <- aliveCounts[-39]
names(aliveCounts) <- c(aliveNames)
aliveCounts
is.na(deceasedCounts)
deceasedCounts <- deceasedCounts[-16]
# Create an object with both count data from both conditions
countData = cbind(aliveCounts,deceasedCounts)
# Create the design matrix for your conditions (eg. Alive and Deceased)
aliveCondition = c(rep("alive", 38))
aliveCondition
deceasedCondition = c(rep("deceased", 15))
conditionInfo = c(aliveCondition,deceasedCondition)
conditionInfo
# Pre-filtering - Remove any gene with a max count that is less than 5
maxes = apply(countData, 1, max)
maxes
which(maxes < 5)
below5 = which(maxes < 5)
countData = countData[-below5,]
Genes = Genes[-below5,]
data.frame(condition = conditionInfo, row.names = colnames(countData))
colData = data.frame(condition = conditionInfo, row.names = colnames(countData))
colData
# Create DESeq Matrix/Dataset
dds <- DESeqDataSetFromMatrix(countData = countData, colData = colData, design = ~ condition)
dds
# Set factor level
dds$condition <- relevel(dds$condition, ref = "alive")
dds$condition
# Running DESeq2
dds = DESeq(dds)
results(dds)
# Getting the results
res = results(dds)
summary(res)
# Change Adj P-Value
res0.01 <- results(dds, alpha = 0.01)
summary(res0.01)
#Add Gene Names back to results
resWithGenes = cbind(Genes,res)
resWithGenes
order(resWithGenes$padj)
resOrdered <- resWithGenes[order(resWithGenes$padj),]
resOrdered
# Looking at the significant genes only based on adjusted p value
topGenesi = which(resOrdered$padj < 0.05)
topGenesi
topGenesTable = resOrdered[topGenesi,]
topGenesTable
# Looking at the significant genes based on adjusted p value and log2FoldChange
topGenesi = which(resOrdered$padj < 0.05 & abs(resOrdered$log2FoldChange) > 2 )
topGenesTable = resOrdered[topGenesi,]
topGenesTable
# Visually inspect the top gene count distribution.
# Inspect any Gene
plotCounts(dds, gene="13422", intgroup=c('condition'),)
topGene <- rownames(res)[which.min(res$padj)]
plotCounts(dds, gene = topGene, intgroup=c("condition"),)
plotMA(res, ylim=c(-2,2))
plotMA(res, ylim=c(-2,2), colSig = "blue", colNonSig = "pink")
#Shrinkage
resultsNames(dds)
resLFC <- lfcShrink(dds, coef="condition_deceased_vs_alive", type="apeglm")
resNorm <- lfcShrink(dds, coef=2, type='normal')
resAsh <- lfcShrink(dds, coef=2, type='ashr')
