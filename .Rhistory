#Pairwise GLOBAL Alignment of Protein Sequences - Needleman Wunsch Algorithm
data(package='Biostrings')
data(PAM30)
PAM30
data(BLOSUM50)
BLOSUM50
proteinA = readAAStringSet(file.choose()) #ns6.fasta
proteinB = readAAStringSet(file.choose()) #nsp1.fasta
proteinA
proteinB
# Using PAM30
globalAlignProteins <- pairwiseAlignment(proteinA, proteinB,
substitutionMatrix = "PAM30",
gapOpening = -2, gapExtension = -8,
scoreOnly = FALSE)
globalAlignProteins
# Using BLOSUM50
globalAlignProteins <- pairwiseAlignment(proteinA, proteinB,
substitutionMatrix = "BLOSUM50",
gapOpening = -2, gapExtension = -8,
scoreOnly = FALSE)
globalAlignProteins
printPairwiseAlignment(globalAlignProteins, 60)
#Pairwise LOCAL alignment of Protein Sequences - Smith-Waterman Algorithm
localAlignProteins <- pairwiseAlignment(proteinA, proteinB,
substitutionMatrix = "BLOSUM50",
gapOpening = -2, gapExtension = -8,
scoreOnly = FALSE, type="local")
localAlignProteins
printPairwiseAlignment(localAlignProteins, 60)
#Multiple Sequence Alignment
multiSeq <- readDNAStringSet(file.choose()) #Rickettsia_23S_rRNA.fasta
multiSeq
multiAlign <- msa(multiSeq, method = ("ClustalW"))
multiAlign
print(multiAlign, show='complete')
#Phylogeny Tree
#Convert msa file to seqinr library input
multiAlign2 <- msaConvert(multiAlign, type="seqinr::alignment")
multiAlign2
#Find distance between sequences
distAlign <- dist.alignment(multiAlign2, "identity")
distAlign
as.matrix(distAlign)
#Neighbor-Joining Tree Estimation
Tree <- nj(distAlign)
Tree
#Plot Phylogenetic Tree
layout(matrix(c(1,1),2,2, byrow = TRUE))
plot(Tree, main="Phylogenetic Tree")
#Save Phylogenetic Tree File
write.tree(Tree, "rickettsiaTree.phylo")
